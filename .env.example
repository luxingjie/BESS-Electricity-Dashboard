# Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional compatibility name for older Supabase projects. The app prefers the
# publishable key above and falls back to this value.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only OpenAI key for import extraction and daily policy ingest.
# Never prefix with NEXT_PUBLIC_ and never commit a real key.
OPENAI_API_KEY=your-openai-api-key

# Optional. Defaults to gpt-5.6-terra.
# OPENAI_MODEL=gpt-5.6-terra

# Server-only Bearer secret for GET/POST /api/cron/policy-ingest (Vercel Cron).
# Also required for local cron smoke tests. Never prefix with NEXT_PUBLIC_.
CRON_SECRET=your-cron-secret

# Local/cron only: Supabase service-role key for trusted ingest writes.
# Never expose to the browser; not required for normal admin JWT flows.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
